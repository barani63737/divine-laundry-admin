ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SERVER_PORT=8080
APP_BASE_URL=https://YOUR_DOMAIN
WEB_ORIGIN=http://localhost:5173
BUSINESS_ZONE=Asia/Kolkata
BUSINESS_NAME=Divine Laundry Trichy
BUSINESS_PHONE=replace-with-business-phone
BUSINESS_ADDRESS=replace-with-business-address
BUSINESS_GST_NUMBER=
UPI_ID=replace-with-verified-business-upi-id
UPI_PAYEE_NAME=Divine Laundry Trichy
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=replace-with-current-supported-version
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-access-token
WHATSAPP_TEMPLATE_NAME=laundry_invoice_payment
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DOCUMENT_TEMPLATE_NAME=replace-with-document-template-name
