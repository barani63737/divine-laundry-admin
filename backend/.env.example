DB_URL=jdbc:mysql://localhost:3306/divine_laundry
DB_USERNAME=laundry_app
DB_PASSWORD=replace-with-runtime-database-password
FLYWAY_ENABLED=true
# Use a separate migration account in production so the runtime app user remains least-privileged.
# The runtime user should not need permanent CREATE/ALTER/INDEX/REFERENCES/DROP privileges.
FLYWAY_DB_URL=jdbc:mysql://localhost:3306/divine_laundry
FLYWAY_DB_USERNAME=replace-with-migration-user
FLYWAY_DB_PASSWORD=replace-with-migration-password
RAZORPAY_ENABLED=false
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=replace-with-test-mode-key-id
RAZORPAY_KEY_SECRET=replace-with-test-mode-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-test-mode-webhook-secret
